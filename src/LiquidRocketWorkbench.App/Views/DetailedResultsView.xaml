<UserControl x:Class="LiquidRocketWorkbench.App.Views.DetailedResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1100"
             d:DesignWidth="960">
  <UserControl.Resources>
    <Style x:Key="DetailGroupTitleStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DetailValueStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,0,12" />
      <Setter Property="Foreground"
              Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CompactValueStyle"
           BasedOn="{StaticResource DetailValueStyle}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,0,9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Border Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                   Text="Detailed result" />
        <TextBlock Margin="0,8,0,22"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="Metric display values are projected from the complete canonical-SI Core result." />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource DetailGroupTitleStyle}"
                       Text="NOZZLE GEOMETRY" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Throat area" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ThroatAreaSquareCentimeters, StringFormat={}{0:N3} cm²}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Exit area" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExitAreaSquareCentimeters, StringFormat={}{0:N3} cm²}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Expansion ratio (Ae/At)" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExpansionRatio, StringFormat={}{0:N3}}" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource DetailGroupTitleStyle}"
                       Text="NOZZLE EXIT STATE" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Exit Mach number" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExitMachNumber, StringFormat=Mach {0:N4}}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Exit pressure" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExitPressureKilopascals, StringFormat={}{0:N3} kPa}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Exit temperature" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExitTemperatureKelvin, StringFormat={}{0:N1} K}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Ideal exit velocity" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding ExitVelocityMetersPerSecond, StringFormat={}{0:N1} m/s}" />
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Style="{StaticResource DetailGroupTitleStyle}"
                       Text="GEOMETRY-DRIVEN FLOW" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Calculated total flow" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding CalculatedMassFlowRateKilogramsPerSecond, StringFormat={}{0:N4} kg/s}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Oxidizer flow" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding OxidizerMassFlowRateKilogramsPerSecond, StringFormat={}{0:N4} kg/s}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Fuel flow" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding FuelMassFlowRateKilogramsPerSecond, StringFormat={}{0:N4} kg/s}" />
            <TextBlock Style="{StaticResource DetailLabelStyle}"
                       Text="Ideal characteristic velocity (c*)" />
            <TextBlock Style="{StaticResource DetailValueStyle}"
                       Text="{Binding CharacteristicVelocityMetersPerSecond, StringFormat={}{0:N1} m/s}" />
          </StackPanel>
        </Grid>

        <Border Margin="0,8,0,0"
                Padding="16"
                Background="#F6F8FB"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="Optional target-flow comparison" />

              <StackPanel Margin="0,12,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasTargetComparison}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource DetailLabelStyle}"
                           Text="Target / absolute difference" />
                <TextBlock Style="{StaticResource CompactValueStyle}">
                  <Run Text="{Binding TargetMassFlowRateKilogramsPerSecond, Mode=OneWay, StringFormat={}{0:N4} kg/s}" />
                  <Run Text=" / " />
                  <Run Text="{Binding AbsoluteTargetDifferenceKilogramsPerSecond, Mode=OneWay, StringFormat={}{0:N4} kg/s}" />
                </TextBlock>
                <TextBlock Style="{StaticResource DetailLabelStyle}"
                           Text="Relative difference" />
                <TextBlock Style="{StaticResource CompactValueStyle}"
                           Text="{Binding RelativeTargetDifferencePercent, StringFormat={}{0:N2}%}" />
              </StackPanel>

              <TextBlock Margin="0,9,0,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="No target supplied; ideal flow remains geometry-driven.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasTargetComparison}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="Burn consumption" />
              <TextBlock Margin="0,12,0,0"
                         Style="{StaticResource DetailLabelStyle}"
                         Text="Total propellant consumed" />
              <TextBlock Text="{Binding PropellantMassConsumedKilograms, StringFormat={}{0:N3} kg}">
                <TextBlock.Style>
                  <Style BasedOn="{StaticResource CompactValueStyle}"
                         TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPropellantMassConsumed}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Margin="0,9,0,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="Enter a burn duration to calculate consumption.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPropellantMassConsumed}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <Border Margin="0,18,0,0"
            Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                   Text="Performance by ambient condition" />
        <TextBlock Margin="0,8,0,18"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="Momentum and pressure thrust remain visible so the ambient-pressure contribution is explicit." />

        <ItemsControl ItemsSource="{Binding AmbientCases}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="5"
                      Padding="16"
                      Background="#F6F8FB"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="9">
                <StackPanel>
                  <TextBlock FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Text="{Binding Label}" />
                  <TextBlock Margin="0,3,0,14"
                             FontSize="12"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Text="{Binding AmbientPressureKilopascals, StringFormat={}{0:N3} kPa ambient}" />
                  <TextBlock Style="{StaticResource DetailLabelStyle}"
                             Text="Total thrust" />
                  <TextBlock Style="{StaticResource CompactValueStyle}"
                             Text="{Binding TotalThrustKilonewtons, StringFormat={}{0:N3} kN}" />
                  <TextBlock Style="{StaticResource DetailLabelStyle}"
                             Text="Momentum / pressure thrust" />
                  <TextBlock Style="{StaticResource CompactValueStyle}">
                    <Run Text="{Binding MomentumThrustKilonewtons, Mode=OneWay, StringFormat={}{0:N3} kN}" />
                    <Run Text=" / " />
                    <Run Text="{Binding PressureThrustKilonewtons, Mode=OneWay, StringFormat={}{0:N3} kN}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource DetailLabelStyle}"
                             Text="Specific impulse / thrust coefficient" />
                  <TextBlock Style="{StaticResource CompactValueStyle}">
                    <Run Text="{Binding SpecificImpulseSeconds, Mode=OneWay, StringFormat={}{0:N2} s}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ThrustCoefficient, Mode=OneWay, StringFormat={}{0:N4}}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource DetailLabelStyle}"
                             Text="Nozzle state" />
                  <TextBlock Margin="0,3,0,0"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="{Binding NozzleExpansionStateLabel}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Margin="0,18,0,0"
            Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                       Text="Model warnings and diagnostics" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding DiagnosticSummary}" />
          </StackPanel>
          <Border Grid.Column="1"
                  Margin="20,0,0,0"
                  Padding="11,7"
                  VerticalAlignment="Top"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="14">
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Text="{Binding WarningCount, StringFormat={}{0} warnings}" />
          </Border>
        </Grid>

        <ItemsControl Margin="0,18,0,0"
                      ItemsSource="{Binding Diagnostics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10"
                      Padding="16"
                      AutomationProperties.Name="{Binding Message}"
                      BorderThickness="1"
                      CornerRadius="9">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF5E8" />
                    <Setter Property="BorderBrush" Value="#F1C58B" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsInformation}"
                                   Value="True">
                        <Setter Property="Background" Value="#EDF5FC" />
                        <Setter Property="BorderBrush" Value="#B9D4EC" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsError}"
                                   Value="True">
                        <Setter Property="Background" Value="#FDECEC" />
                        <Setter Property="BorderBrush" Value="#E6B5B5" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border MinWidth="76"
                          Padding="9,5"
                          VerticalAlignment="Top"
                          Background="#FFFFFF"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding SeverityLabel}" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="14,0,0,0">
                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                      <TextBlock FontFamily="Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding Code}" />
                      <TextBlock Margin="12,0,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding FieldLabel, StringFormat=Field: {0}}"
                                 Visibility="{Binding HasField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
