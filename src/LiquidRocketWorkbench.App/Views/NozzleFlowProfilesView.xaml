<UserControl x:Class="LiquidRocketWorkbench.App.Views.NozzleFlowProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LiquidRocketWorkbench.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="960">
  <UserControl.Resources>
    <converters:ProfilePointsToPointCollectionConverter
        x:Key="ProfilePointsConverter" />
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorderStyle}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock AutomationProperties.Name="Normalized nozzle flow profiles"
                     Style="{StaticResource SectionTitleTextStyle}"
                     Text="Nozzle flow profiles" />
          <TextBlock Margin="0,7,0,0"
                     Style="{StaticResource SecondaryTextStyle}"
                     Text="Compare the ideal static state and Mach progression from chamber through the choked throat to the exit." />
        </StackPanel>
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Padding="11,7"
                VerticalAlignment="Top"
                Background="#E7F0F8"
                CornerRadius="14">
          <TextBlock FontSize="11"
                     FontWeight="Bold"
                     Foreground="#2F6FA3"
                     Text="NORMALIZED AXIS" />
        </Border>
      </Grid>

      <Border Margin="0,18,0,0"
              Padding="14"
              Background="#F6F8FB"
              CornerRadius="8">
        <StackPanel>
          <TextBlock AutomationProperties.Name="{Binding AxisCaption}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="{Binding AxisCaption}" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="12"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="{Binding ModelNotice}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl Margin="0,16,0,0"
                    ItemsSource="{Binding Series}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12"
                    Padding="16"
                    Background="#F9FBFD"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="5"
                          Height="22"
                          Margin="0,0,10,0"
                          Background="{Binding StrokeColor}"
                          CornerRadius="3" />
                  <TextBlock Grid.Column="1"
                             AutomationProperties.Name="{Binding AccessibilitySummary}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Text="{Binding Title}" />
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource MutedTextBrush}"
                             Text="{Binding Unit}" />
                </Grid>

                <Viewbox Margin="0,12,0,0"
                         Stretch="Uniform">
                  <Canvas Width="900"
                          Height="138">
                    <Rectangle Width="900"
                               Height="138"
                               Fill="#F9FBFD" />

                    <Line X1="80"
                          Y1="18"
                          X2="865"
                          Y2="18"
                          Stroke="#D7DFE9"
                          StrokeThickness="1" />
                    <Line X1="80"
                          Y1="63"
                          X2="865"
                          Y2="63"
                          Stroke="#E3E8EF"
                          StrokeDashArray="4,4"
                          StrokeThickness="1" />
                    <Line X1="80"
                          Y1="108"
                          X2="865"
                          Y2="108"
                          Stroke="#D7DFE9"
                          StrokeThickness="1" />

                    <Line X1="80"
                          Y1="10"
                          X2="80"
                          Y2="116"
                          Stroke="#7F8B9D"
                          StrokeThickness="1" />
                    <Line X1="354.75"
                          Y1="10"
                          X2="354.75"
                          Y2="116"
                          Stroke="#7F8B9D"
                          StrokeDashArray="4,4"
                          StrokeThickness="1" />
                    <Line X1="865"
                          Y1="10"
                          X2="865"
                          Y2="116"
                          Stroke="#7F8B9D"
                          StrokeThickness="1" />

                    <Polyline Points="{Binding PlotPoints, Converter={StaticResource ProfilePointsConverter}}"
                              Stroke="{Binding StrokeColor}"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeThickness="4" />

                    <TextBlock Canvas.Left="0"
                               Canvas.Top="7"
                               Width="72"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding MaximumValueText}"
                               TextAlignment="Right" />
                    <TextBlock Canvas.Left="0"
                               Canvas.Top="97"
                               Width="72"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding MinimumValueText}"
                               TextAlignment="Right" />

                    <TextBlock Canvas.Left="80"
                               Canvas.Top="119"
                               Width="120"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="CHAMBER" />
                    <TextBlock Canvas.Left="314.75"
                               Canvas.Top="119"
                               Width="80"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="THROAT"
                               TextAlignment="Center" />
                    <TextBlock Canvas.Left="805"
                               Canvas.Top="119"
                               Width="60"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="EXIT"
                               TextAlignment="Right" />
                  </Canvas>
                </Viewbox>

                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding Stations}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,8,0"
                              Padding="10,8"
                              Background="White"
                              CornerRadius="6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding PositionText, StringFormat='x = {0}'}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     Text="{Binding ValueText}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
