<UserControl x:Class="LiquidRocketWorkbench.App.Views.NozzleStationDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="960">
  <Border Style="{StaticResource CardBorderStyle}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock AutomationProperties.Name="Nozzle station diagram"
                     Style="{StaticResource SectionTitleTextStyle}"
                     Text="Engine and nozzle stations" />
          <TextBlock Margin="0,7,0,0"
                     Style="{StaticResource SecondaryTextStyle}"
                     Text="Follow the idealized flow path from propellant entry through the supersonic exit plane." />
        </StackPanel>
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Padding="11,7"
                VerticalAlignment="Top"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="14">
          <TextBlock FontSize="11"
                     FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"
                     Text="{Binding StateLabel}" />
        </Border>
      </Grid>

      <Grid Margin="0,18,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock AutomationProperties.Name="{Binding StateSummary}"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding StateSummary}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Column="1"
                   Margin="22,0,0,0"
                   FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding ScaleNotice}" />
      </Grid>

      <Border Padding="8"
              Background="#F8FAFC"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Viewbox Stretch="Uniform">
          <Canvas Width="900"
                  Height="360"
                  ClipToBounds="True">
            <Rectangle Width="900"
                       Height="360"
                       Fill="#F8FAFC" />

            <Path Data="M 92,86 L 330,86 C 370,86 400,110 426,125 L 458,125 C 530,120 638,73 754,42 L 786,42 L 786,248 L 754,248 C 638,217 530,170 458,165 L 426,165 C 400,180 370,204 330,204 L 92,204 Z"
                  Fill="#E6EBF2"
                  Stroke="#43546A"
                  StrokeThickness="3" />

            <Path Data="M 121,104 L 328,104 C 365,104 394,126 424,137 L 457,137 C 535,131 639,91 752,62 L 752,228 C 639,199 535,159 457,153 L 424,153 C 394,164 365,186 328,186 L 121,186 Z"
                  Stroke="#B64525"
                  StrokeThickness="2">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">
                  <GradientStop Offset="0"
                                Color="#F29A4A" />
                  <GradientStop Offset="0.46"
                                Color="#E45D2F" />
                  <GradientStop Offset="1"
                                Color="#7EAED1" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>

            <Rectangle Canvas.Left="96"
                       Canvas.Top="91"
                       Width="25"
                       Height="108"
                       Fill="#203957"
                       RadiusX="3"
                       RadiusY="3" />
            <Ellipse Canvas.Left="104"
                     Canvas.Top="111"
                     Width="9"
                     Height="9"
                     Fill="White" />
            <Ellipse Canvas.Left="104"
                     Canvas.Top="140"
                     Width="9"
                     Height="9"
                     Fill="White" />
            <Ellipse Canvas.Left="104"
                     Canvas.Top="169"
                     Width="9"
                     Height="9"
                     Fill="White" />

            <Line X1="52"
                  Y1="116"
                  X2="91"
                  Y2="116"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="3" />
            <Line X1="52"
                  Y1="145"
                  X2="91"
                  Y2="145"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="3" />
            <Line X1="52"
                  Y1="174"
                  X2="91"
                  Y2="174"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="3" />
            <Path Data="M 91,109 L 103,116 L 91,123 Z M 91,138 L 103,145 L 91,152 Z M 91,167 L 103,174 L 91,181 Z"
                  Fill="{StaticResource AccentBrush}" />

            <Line X1="135"
                  Y1="145"
                  X2="725"
                  Y2="145"
                  Stroke="#FFFFFF"
                  StrokeDashArray="7,5"
                  StrokeThickness="2" />
            <Path Data="M 725,138 L 741,145 L 725,152 Z"
                  Fill="#FFFFFF" />

            <Rectangle Canvas.Left="423"
                       Canvas.Top="131"
                       Width="36"
                       Height="28"
                       Fill="Transparent"
                       Stroke="#172033"
                       StrokeThickness="2" />
            <Line X1="752"
                  Y1="59"
                  X2="752"
                  Y2="231"
                  Stroke="#172033"
                  StrokeThickness="3" />

            <Line X1="108"
                  Y1="20"
                  X2="108"
                  Y2="257"
                  Stroke="#7F8B9D"
                  StrokeDashArray="4,4"
                  StrokeThickness="1" />
            <Line X1="260"
                  Y1="20"
                  X2="260"
                  Y2="257"
                  Stroke="#7F8B9D"
                  StrokeDashArray="4,4"
                  StrokeThickness="1" />
            <Line X1="441"
                  Y1="20"
                  X2="441"
                  Y2="257"
                  Stroke="#7F8B9D"
                  StrokeDashArray="4,4"
                  StrokeThickness="1" />
            <Line X1="752"
                  Y1="20"
                  X2="752"
                  Y2="257"
                  Stroke="#7F8B9D"
                  StrokeDashArray="4,4"
                  StrokeThickness="1" />

            <Border Canvas.Left="94"
                    Canvas.Top="8"
                    Width="28"
                    Height="28"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="White"
                         Text="{Binding Injector.StationNumber}" />
            </Border>
            <Border Canvas.Left="246"
                    Canvas.Top="8"
                    Width="28"
                    Height="28"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="White"
                         Text="{Binding Chamber.StationNumber}" />
            </Border>
            <Border Canvas.Left="427"
                    Canvas.Top="8"
                    Width="28"
                    Height="28"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="White"
                         Text="{Binding Throat.StationNumber}" />
            </Border>
            <Border Canvas.Left="738"
                    Canvas.Top="8"
                    Width="28"
                    Height="28"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="White"
                         Text="{Binding Exit.StationNumber}" />
            </Border>

            <StackPanel Canvas.Left="23"
                        Canvas.Top="264"
                        Width="170">
              <TextBlock AutomationProperties.Name="{Binding Injector.AccessibilityName}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="{Binding Injector.Name}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="{Binding Injector.Role}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,5,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding Injector.ValueText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Canvas.Left="175"
                        Canvas.Top="264"
                        Width="170">
              <TextBlock AutomationProperties.Name="{Binding Chamber.AccessibilityName}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="{Binding Chamber.Name}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="{Binding Chamber.Role}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,5,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding Chamber.ValueText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Canvas.Left="356"
                        Canvas.Top="264"
                        Width="170">
              <TextBlock AutomationProperties.Name="{Binding Throat.AccessibilityName}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="{Binding Throat.Name}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="{Binding Throat.Role}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,5,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding Throat.ValueText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Canvas.Left="657"
                        Canvas.Top="264"
                        Width="190">
              <TextBlock AutomationProperties.Name="{Binding Exit.AccessibilityName}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Text="{Binding Exit.Name}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="{Binding Exit.Role}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,5,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding Exit.ValueText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Canvas>
        </Viewbox>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
