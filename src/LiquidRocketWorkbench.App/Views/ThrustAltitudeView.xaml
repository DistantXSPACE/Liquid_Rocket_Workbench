<UserControl x:Class="LiquidRocketWorkbench.App.Views.ThrustAltitudeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LiquidRocketWorkbench.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="960">
  <UserControl.Resources>
    <converters:ProfilePointsToPointCollectionConverter
        x:Key="ProfilePointsConverter" />
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorderStyle}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock AutomationProperties.Name="Thrust versus standard altitude plot"
                     Style="{StaticResource SectionTitleTextStyle}"
                     Text="Thrust versus altitude" />
          <TextBlock Margin="0,7,0,0"
                     Style="{StaticResource SecondaryTextStyle}"
                     Text="Track ideal thrust as standard atmospheric pressure falls from sea level through 50 km geopotential altitude." />
        </StackPanel>
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Padding="11,7"
                VerticalAlignment="Top"
                Background="#E7F0F8"
                CornerRadius="14">
          <TextBlock FontSize="11"
                     FontWeight="Bold"
                     Foreground="#2F6FA3"
                     Text="U.S. STD ATM 1976" />
        </Border>
      </Grid>

      <UniformGrid Margin="0,18,0,0"
                   Columns="3">
        <Border Margin="0,0,8,0"
                Padding="12"
                Background="#F6F8FB"
                CornerRadius="8">
          <StackPanel>
            <TextBlock FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="SELECTED AMBIENT" />
            <TextBlock Margin="0,5,0,0"
                       AutomationProperties.Name="{Binding SelectedAmbientSummary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding SelectedAmbientSummary}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Margin="4,0"
                Padding="12"
                Background="#F6F8FB"
                CornerRadius="8">
          <StackPanel>
            <TextBlock FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="SEA LEVEL" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding SeaLevelSummary}" />
          </StackPanel>
        </Border>
        <Border Margin="8,0,0,0"
                Padding="12"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="8">
          <StackPanel>
            <TextBlock FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       Text="VACUUM REFERENCE" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding VacuumSummary}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Margin="0,16,0,0"
              Padding="12"
              Background="#F9FBFD"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="9">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="18"
                      Height="4"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Background="#2F6FA3"
                      CornerRadius="2" />
              <TextBlock AutomationProperties.Name="{Binding CurveAccessibilitySummary}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="IDEAL THRUST CURVE" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}"
                       Text="{Binding ThrustGainText}" />
          </Grid>

          <Viewbox Margin="0,12,0,0"
                   Stretch="Uniform">
            <Canvas Width="900"
                    Height="225">
              <Rectangle Width="900"
                         Height="225"
                         Fill="#F9FBFD" />

              <Line X1="80"
                    Y1="22"
                    X2="865"
                    Y2="22"
                    Stroke="{StaticResource AccentBrush}"
                    StrokeDashArray="6,4"
                    StrokeThickness="1.5" />
              <Line X1="80"
                    Y1="77.33"
                    X2="865"
                    Y2="77.33"
                    Stroke="#E3E8EF"
                    StrokeDashArray="4,4"
                    StrokeThickness="1" />
              <Line X1="80"
                    Y1="132.67"
                    X2="865"
                    Y2="132.67"
                    Stroke="#E3E8EF"
                    StrokeDashArray="4,4"
                    StrokeThickness="1" />
              <Line X1="80"
                    Y1="188"
                    X2="865"
                    Y2="188"
                    Stroke="#D7DFE9"
                    StrokeThickness="1" />

              <Line X1="80" Y1="16" X2="80" Y2="196"
                    Stroke="#7F8B9D" StrokeThickness="1" />
              <Line X1="237" Y1="16" X2="237" Y2="196"
                    Stroke="#D7DFE9" StrokeDashArray="4,4" StrokeThickness="1" />
              <Line X1="394" Y1="16" X2="394" Y2="196"
                    Stroke="#D7DFE9" StrokeDashArray="4,4" StrokeThickness="1" />
              <Line X1="551" Y1="16" X2="551" Y2="196"
                    Stroke="#D7DFE9" StrokeDashArray="4,4" StrokeThickness="1" />
              <Line X1="708" Y1="16" X2="708" Y2="196"
                    Stroke="#D7DFE9" StrokeDashArray="4,4" StrokeThickness="1" />
              <Line X1="865" Y1="16" X2="865" Y2="196"
                    Stroke="#7F8B9D" StrokeThickness="1" />

              <Polyline Points="{Binding CurvePoints, Converter={StaticResource ProfilePointsConverter}}"
                        Stroke="#2F6FA3"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeThickness="4" />

              <Ellipse Width="12"
                       Height="12"
                       Canvas.Left="{Binding SelectedMarkerLeft}"
                       Canvas.Top="{Binding SelectedMarkerTop}"
                       AutomationProperties.Name="{Binding SelectedAmbientSummary}"
                       Fill="{StaticResource AccentBrush}"
                       Stroke="White"
                       StrokeThickness="2"
                       Visibility="{Binding HasSelectedStandardAltitude, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <TextBlock Canvas.Left="0"
                         Canvas.Top="11"
                         Width="72"
                         FontSize="10"
                         Foreground="{StaticResource AccentBrush}"
                         Text="{Binding MaximumThrustText}"
                         TextAlignment="Right" />
              <TextBlock Canvas.Left="0"
                         Canvas.Top="177"
                         Width="72"
                         FontSize="10"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding MinimumThrustText}"
                         TextAlignment="Right" />

              <TextBlock Canvas.Left="80" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="0 km" />
              <TextBlock Canvas.Left="212" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="10" TextAlignment="Center" />
              <TextBlock Canvas.Left="369" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="20" TextAlignment="Center" />
              <TextBlock Canvas.Left="526" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="30" TextAlignment="Center" />
              <TextBlock Canvas.Left="683" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="40" TextAlignment="Center" />
              <TextBlock Canvas.Left="815" Canvas.Top="202" Width="50"
                         FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                         Text="50 km" TextAlignment="Right" />
            </Canvas>
          </Viewbox>

          <ItemsControl Margin="0,10,0,0"
                        ItemsSource="{Binding Stations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,8"
                        Padding="10"
                        Background="White"
                        CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding AltitudeText}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding AmbientPressureText}" />
                    <TextBlock Grid.Column="2"
                               Margin="10,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ThrustText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Margin="0,4,0,0"
              Padding="14"
              Background="#F6F8FB"
              CornerRadius="8">
        <TextBlock AutomationProperties.Name="{Binding ModelNotice}"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding ModelNotice}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
