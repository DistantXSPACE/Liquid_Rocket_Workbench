<UserControl x:Class="LiquidRocketWorkbench.App.Views.OperatingPointComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="960">
  <Border Style="{StaticResource CardBorderStyle}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock AutomationProperties.Name="Operating point comparison"
                     Style="{StaticResource SectionTitleTextStyle}"
                     Text="Operating-point comparison" />
          <TextBlock Margin="0,7,0,0"
                     Style="{StaticResource SecondaryTextStyle}"
                     Text="Save up to four successful results, then compare their inputs and performance side by side." />
        </StackPanel>
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Padding="11,7"
                VerticalAlignment="Top"
                Background="#E7F0F8"
                CornerRadius="14">
          <TextBlock AutomationProperties.Name="{Binding SavedOperatingPointCountText}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="#2F6FA3"
                     Text="{Binding SavedOperatingPointCountText}" />
        </Border>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button AutomationProperties.AcceleratorKey="Alt+S"
                AutomationProperties.Name="Save current result for comparison"
                Command="{Binding SaveCurrentOperatingPointCommand}"
                Content="{Binding SaveOperatingPointButtonText}"
                Style="{StaticResource PrimaryButtonStyle}" />
        <Button Grid.Column="1"
                Margin="10,0,0,0"
                Padding="15,9"
                AutomationProperties.AcceleratorKey="Alt+L"
                AutomationProperties.Name="Clear saved operating points"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Command="{Binding ClearOperatingPointComparisonsCommand}"
                Content="Clear all"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}" />
        <TextBlock Grid.Column="2"
                   Margin="18,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding ComparisonProtectionNotice}"
                   TextWrapping="Wrap" />
      </Grid>

      <Border Margin="0,16,0,0"
              Padding="16"
              Background="#F6F8FB"
              CornerRadius="8"
              Visibility="{Binding IsOperatingPointComparisonEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock AutomationProperties.Name="Empty operating point comparison"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="No saved operating points yet" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="12"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Calculate a valid point, save its current result, then edit and recalculate to build a read-only comparison set."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl Margin="0,16,0,0"
                    ItemsSource="{Binding SavedOperatingPoints}"
                    Visibility="{Binding HasSavedOperatingPoints, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,10,10"
                    Padding="15"
                    Background="#F9FBFD"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock AutomationProperties.Name="{Binding AccessibilitySummary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding DisplayName}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding PropellantLabel}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Width="32"
                          Height="32"
                          AutomationProperties.Name="{Binding RemoveAccessibilityName}"
                          Background="White"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          Command="{Binding RemoveCommand}"
                          Content="×"
                          Cursor="Hand"
                          FontSize="15"
                          Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="White"
                        CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="CHAMBER / GAS" />
                      <TextBlock Margin="0,4,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding ChamberPressureMegapascals, StringFormat=Pc {0:N3} MPa}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding ChamberTemperatureKelvin, StringFormat=Tc {0:N1} K}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding MixtureRatio, StringFormat=O/F {0:N3}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="NOZZLE / AMBIENT" />
                      <TextBlock Margin="0,4,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding ExpansionRatio, StringFormat=ε {0:N2}}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding ThroatDiameterMillimeters, StringFormat=dt {0:N2} mm}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding AmbientPressureKilopascals, StringFormat=Pa {0:N3} kPa}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <UniformGrid Margin="0,10,0,0"
                             Columns="2">
                  <Border Margin="0,0,5,0"
                          Padding="10"
                          Background="{StaticResource AccentSoftBrush}"
                          CornerRadius="6">
                    <StackPanel>
                      <TextBlock FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource AccentBrush}"
                                 Text="SELECTED" />
                      <TextBlock Margin="0,5,0,0"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding SelectedThrustKilonewtons, StringFormat={}{0:N3} kN}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding SelectedSpecificImpulseSeconds, StringFormat={}{0:N1} s Isp}" />
                    </StackPanel>
                  </Border>
                  <Border Margin="5,0,0,0"
                          Padding="10"
                          Background="#EDF1F6"
                          CornerRadius="6">
                    <StackPanel>
                      <TextBlock FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="VACUUM" />
                      <TextBlock Margin="0,5,0,0"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding VacuumThrustKilonewtons, StringFormat={}{0:N3} kN}" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding VacuumSpecificImpulseSeconds, StringFormat={}{0:N1} s Isp}" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding SeaLevelThrustKilonewtons, StringFormat=Sea level {0:N3} kN}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding CalculatedMassFlowRateKilogramsPerSecond, StringFormat=Ideal flow {0:N3} kg/s}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding WarningSummary}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ExitMachNumber, StringFormat=Exit Mach {0:N4}}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ExitPressureKilopascals, StringFormat=Pe {0:N3} kPa}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding NozzleExpansionStateLabel}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
